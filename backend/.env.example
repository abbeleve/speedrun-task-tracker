# Optional: override the SQLite database location.
# Defaults to <repo>/backend/data/tracker.db when unset.
# DATABASE_PATH=/var/lib/speedrun/tracker.db

# Optional: directory the motivational pictures are served from.
# Defaults to <repo>/backend/data/motivation when unset. Kept out of git so
# pictures can be dropped in on the server.
# MOTIVATION_DIR=/home/deploy/speedrun-task-tracker/backend/data/motivation

# Bind host/port (used by uvicorn, e.g. started via run.py)
# HOST=0.0.0.0
# PORT=8000
